# Xcode
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.dSYM
*.dSYM.zip

# Swift Package Manager (Package.resolved IS kept — see note below)
.build/
.swiftpm/

# NOTE: Package.resolved is intentionally NOT ignored. For an app (not a
# library) it should be committed so every machine building this project
# resolves the exact same dependency versions (this project was broken more
# than once this way — see the Firebase package-graph issues in project
# history).

# CocoaPods (not currently used, ignored in case that changes)
Pods/

# Firebase CLI local state / logs — not source, regenerated by `firebase` CLI
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
pubsub-debug.log

# Firebase Functions backend (Node/TypeScript) — dependencies and compiled output
backend/node_modules/
backend/lib/
node_modules/

# macOS
.DS_Store

# Firebase config — this repo is public, so the real file (with a live API
# key and project ID) is excluded. TalkDaily/GoogleService-Info.plist.example
# shows the exact structure needed; copy it to GoogleService-Info.plist and
# fill in your own project's values (or ask for the real one out-of-band) to
# build.
TalkDaily/GoogleService-Info.plist
